*********
*Sources*
*********

.param VD=0.0
.param VS=0.0
.param VG=0.634
.param VB=-1.2

Vd d 0 {VD}
Vs s 0 {VS}
Vg g 0 {VG}
Vb b 0 {VB}

*********
*Circuit*
*********

.param W=1.8e-07
.param L=1.4e-07
.param AD=1.026e-13
.param AS=1.026e-13
.param PD=1.34e-06
.param PS=1.34e-06
.param NF=1
.param M=1

XU1 d g s b sg13_lv_nmos
+ w={W} l={L} m={M} ng={NF} ad={AD} as={AS} pd={PD} ps={PS}

* ============================================================================================
* ----------------------------------------- ANALYSIS -----------------------------------------
* ============================================================================================

.temp 27.0000                           

.control
  set filetype=ascii
  set wr_singlescale
  set wr_vecnames

  dc vd 0 1.35 0.05

  let ib = -i(Vb)
  let id = -i(Vd)
  let ig = -i(Vg)
  let is = -i(Vs)

  wrdata models_results/nmos_lv/run_data/dc_idvd_50a9c3b2-3d3b-45fb-9df1-062d1eddd7bf_mos_ff.csv v(d) ib id ig is 
  quit
.endc

* ============================================================================================
* ------------------------------------- CIR/MODELS-SETUP -------------------------------------
* ============================================================================================

**************************
*including files & models*
**************************

.lib ../../../../libs.tech/ngspice/models/cornerMOSlv.lib mos_ff  

.end