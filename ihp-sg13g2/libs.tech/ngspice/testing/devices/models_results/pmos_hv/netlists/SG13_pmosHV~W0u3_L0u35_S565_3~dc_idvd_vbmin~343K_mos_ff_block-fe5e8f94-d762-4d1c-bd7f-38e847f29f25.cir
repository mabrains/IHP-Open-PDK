*********
*Sources*
*********

.param VD=-0.0
.param VS=-0.0
.param VG=-2.62
.param VB=3.6

Vd d 0 {VD}
Vs s 0 {VS}
Vg g 0 {VG}
Vb b 0 {VB}

*********
*Circuit*
*********

.param W=3e-07
.param L=3.5e-07
.param AD=1.02e-13
.param AS=1.02e-13
.param PD=1.28e-06
.param PS=1.28e-06
.param NF=1
.param M=1

XU1 d g s b sg13_hv_pmos
+ w={W} l={L} m={M} ng={NF} ad={AD} as={AS} pd={PD} ps={PS}

* ============================================================================================
* ----------------------------------------- ANALYSIS -----------------------------------------
* ============================================================================================

.temp 70.0000                           

.control
  set filetype=ascii
  set wr_singlescale
  set wr_vecnames

  dc vd -0 -3.6 -0.1

  let ib = -i(Vb)
  let id = -i(Vd)
  let ig = -i(Vg)
  let is = -i(Vs)

  wrdata models_results/pmos_hv/run_data/dc_idvd_fe5e8f94-d762-4d1c-bd7f-38e847f29f25_mos_ff.csv v(d) ib id ig is 
  quit
.endc

* ============================================================================================
* ------------------------------------- CIR/MODELS-SETUP -------------------------------------
* ============================================================================================

**************************
*including files & models*
**************************

.lib ../../../../libs.tech/ngspice/models/cornerMOShv.lib mos_ff  

.end