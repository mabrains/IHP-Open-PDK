*********
*Sources*
*********

.param VD=1.7
.param VS=0.0
.param VG=-0.5
.param VB=-3.6

Vd d 0 {VD}
Vs s 0 {VS}
Vg g 0 {VG}
Vb b 0 {VB}

*********
*Circuit*
*********

.param W=2e-06
.param L=3.3e-07
.param AD=6.8e-13
.param AS=6.8e-13
.param PD=4.68e-06
.param PS=4.68e-06
.param NF=1
.param M=1

XU1 d g s b sg13_hv_nmos
+ w={W} l={L} m={M} ng={NF} ad={AD} as={AS} pd={PD} ps={PS}

* ============================================================================================
* ----------------------------------------- ANALYSIS -----------------------------------------
* ============================================================================================

.temp 27.0000                           

.control
  set filetype=ascii
  set wr_singlescale
  set wr_vecnames

  dc vg -0.5 3.6 0.05

  let ib = -i(Vb)
  let id = -i(Vd)
  let ig = -i(Vg)
  let is = -i(Vs)

  wrdata models_results/nmos_hv/run_data/dc_idvg_8d9b0d75-0eec-4d2a-9cb2-39f8ee6dd15f_mos_tt.csv v(g) ib id ig is 
  quit
.endc

* ============================================================================================
* ------------------------------------- CIR/MODELS-SETUP -------------------------------------
* ============================================================================================

**************************
*including files & models*
**************************

.lib ../../../../libs.tech/ngspice/models/cornerMOShv.lib mos_tt  

.end