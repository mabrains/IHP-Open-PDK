*********
*Sources*
*********

.param VD=0.0
.param VS=0.0
.param VG=0.0
.param VB=0.0

Vd d 0 {VD}
Vs s 0 {VS}
Vg g 0 {VG}
Vb b 0 {VB}

*********
*Circuit*
*********

.param W=1e-06
.param L=1e-06
.param AD=0
.param AS=3.75e-08
.param PD=0
.param PS=0.00085
.param NF=1
.param M=1

XU1 d g s b sg13_hv_nmos
+ w={W} l={L} m={M} ng={NF} ad={AD} as={AS} pd={PD} ps={PS}

* ============================================================================================
* ----------------------------------------- ANALYSIS -----------------------------------------
* ============================================================================================

.temp 27.0000                           

.control
  set filetype=ascii
  set wr_singlescale
  set wr_vecnames

  dc vs 0 5 0.1

  let ib = -i(Vb)
  let id = -i(Vd)
  let ig = -i(Vg)
  let is = -i(Vs)

  wrdata models_results/nmos_hv/run_data/di_bs_area_661d703a-57a4-4b4c-bf2e-d9984209a729_mos_ss.csv v(s) ib id ig is 
  quit
.endc

* ============================================================================================
* ------------------------------------- CIR/MODELS-SETUP -------------------------------------
* ============================================================================================

**************************
*including files & models*
**************************

.lib ../../../../libs.tech/ngspice/models/cornerMOShv.lib mos_ss  

.end