*********
*Sources*
*********

.param VD=-0.0
.param VS=-0.0
.param VG=-1.156
.param VB=1.2

Vd d 0 {VD}
Vs s 0 {VS}
Vg g 0 {VG}
Vb b 0 {VB}

*********
*Circuit*
*********

.param W=1e-05
.param L=1.3e-07
.param AD=3.4e-12
.param AS=3.4e-12
.param PD=2.068e-05
.param PS=2.068e-05
.param NF=1
.param M=1

XU1 d g s b sg13_lv_pmos
+ w={W} l={L} m={M} ng={NF} ad={AD} as={AS} pd={PD} ps={PS}

* ============================================================================================
* ----------------------------------------- ANALYSIS -----------------------------------------
* ============================================================================================

.temp 125.000                           

.control
  set filetype=ascii
  set wr_singlescale
  set wr_vecnames

  dc vd -0 -1.35 -0.05

  let ib = -i(Vb)
  let id = -i(Vd)
  let ig = -i(Vg)
  let is = -i(Vs)

  wrdata models_results/pmos_lv/run_data/dc_idvd_74b17b9d-b1e3-4ab7-abda-b66325b80c28_mos_ff.csv v(d) ib id ig is 
  quit
.endc

* ============================================================================================
* ------------------------------------- CIR/MODELS-SETUP -------------------------------------
* ============================================================================================

**************************
*including files & models*
**************************

.lib ../../../../libs.tech/ngspice/models/cornerMOSlv.lib mos_ff  

.end